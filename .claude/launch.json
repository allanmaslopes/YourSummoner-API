{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "D:/Workspace/YourSummoner-API/.claude/run-api.cmd"
      ],
      "port": 8080
    },
    {
      "name": "riot-mock",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        ".claude/riot-mock.py"
      ],
      "port": 8089
    },
    {
      "name": "api-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "D:/Workspace/YourSummoner-API/.claude/run-api.cmd",
        "--riot.api.base-url-template=http://localhost:8089/riot/{host}"
      ],
      "port": 8080
    },
    {
      "name": "web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd /d D:\\Workspace\\YourSummoner-Web && go run ."
      ],
      "port": 3000
    }
  ]
}