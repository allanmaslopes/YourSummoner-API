          "in" : "path",
          "name" : "nick",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Tag do invocador (parte depois do #)",
          "in" : "path",
          "name" : "tag",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Plataforma da Riot (BR1, NA1, EUW1, KR...). Padrão: BR1",
          "in" : "query",
          "name" : "platform",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SummonerProfileResponse"
                }
              }
            },
            "description" : "Perfil do invocador"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SummonerProfileResponse"
                }
              }
            },
            "description" : "Entrada inválida"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SummonerProfileResponse"
                }
              }
            },
            "description" : "Não encontrado"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SummonerProfileResponse"
                }
              }
            },
            "description" : "Rate limit da Riot (header Retry-After)"
          },
          "502" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SummonerProfileResponse"
                }
              }
            },
            "description" : "Credencial rejeitada ou resposta inválida do upstream"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SummonerProfileResponse"
                }
              }
            },
            "description" : "Upstream indisponível ou circuito aberto"
          }
        },
        "summary" : "Perfil do invocador: nível, ícone, ranqueadas e 3 campeões principais",
        "tags" : [ "Summoners" ]
      }
